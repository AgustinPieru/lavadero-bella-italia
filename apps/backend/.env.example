DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bellaitalia"
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
PORT=3002
NODE_ENV=development
FRONTEND_URL="http://localhost:5174"
BACKEND_URL="http://localhost:3002"

# ARCA (ex-AFIP) — Factura Electrónica (WSFEv1). Mientras falten estos 4,
# la facturación funciona en modo "comprobante interno" para todos los
# clientes y la integración con ARCA queda sin activar (ver
# apps/backend/src/lib/arca/config.ts).
ARCA_ENV="homologacion"
ARCA_CUIT=""
ARCA_CERT_PATH=""
ARCA_KEY_PATH=""
ARCA_PUNTO_VENTA=""

# WhatsApp (whatsapp-web.js) — confirmación de turnos y encuesta de Reseñas.
# Necesita una sesión real: con WHATSAPP_ENABLED=true, al iniciar el backend
# se imprime un QR en consola (y se guarda como imagen en
# apps/backend/.wwebjs_auth/ultimo-qr.png) para escanear con el número
# dedicado del lavadero. Mientras esté en false, el envío queda deshabilitado
# y no se levanta ninguna sesión (ver apps/backend/src/lib/whatsapp/config.ts).
WHATSAPP_ENABLED=false
# Headless por default (true). Poner en false SOLO mientras se vincula el
# número por primera vez, para ver el QR en una ventana real de Chrome —
# dejarlo en false el resto del tiempo hace que macOS pueda suspender esa
# ventana sin foco y cortar la sesión ("detached Frame" al enviar).
WHATSAPP_HEADLESS=true
