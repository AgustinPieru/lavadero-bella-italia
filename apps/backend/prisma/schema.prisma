generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Etapa 1 (scaffolding): Prisma no genera el cliente sin al menos un modelo,
// así que User/RefreshToken arrancan acá — es el modelo de datos mínimo e
// inevitable para validar que Prisma + Postgres funcionan de punta a punta.
// La lógica de login (endpoints, JWT, etc.) se construye recién en la Etapa 2.
// El resto de los modelos (Cliente, Turno, Servicio, Empresa, Factura...)
// se agregan a medida que avanzamos por las etapas siguientes.

enum Role {
  ADMIN
  OPERATOR
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String
  role          Role           @default(ADMIN)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ──────────────────────────────────────────────
// Etapa 3a/3b: Cliente, Vehiculo y Servicio se modelan acá como tablas reales
// (Turno necesita referenciarlos por FK, no por texto libre como en la demo).
//
// Cliente = datos de contacto (una denominación, un teléfono/email/CUIT).
// Vehiculo = uno de los vehículos de ese cliente (tipo/subtipo/marca/patente).
// Un cliente puede tener N vehículos (ej. una empresa con varios camiones) —
// por eso van separados y no mezclados en una sola tabla como en la demo,
// donde cada vehículo era directamente un "cliente" repetido.
//
// Empresa (cuenta corriente, facturación consolidada, tarifas diferenciales)
// todavía NO se modela aparte: hoy una empresa simplemente ES un Cliente con
// varios Vehiculo. Se revisa en la Etapa 3e si necesita algo más (tarifas,
// cuenta corriente) que no sea ya cubierto por tener un Cliente propio.
// ──────────────────────────────────────────────

enum VehiculoTipo {
  CAMION
  AUTO
}

enum TipoFacturacion {
  ARCA
  INTERNA
}

model Cliente {
  id                        Int              @id @default(autoincrement())
  denominacion              String
  telefono                  String
  cuit                      String?
  email                     String?
  direccion                 String?
  activo                    Boolean          @default(true) // "baja" = desactivar, no borrar (preserva el historial de turnos)
  // Etapa 3e (Empresas): una empresa ES un Cliente con estos campos de negocio
  // cargados — no hay una tabla aparte. esEmpresa controla si se muestra en
  // la pantalla de Empresas y habilita descuento/facturación/cuenta corriente.
  esEmpresa                 Boolean          @default(false) @map("es_empresa")
  descuentoPct              Int?             @map("descuento_pct")
  facturacion               TipoFacturacion?
  cuentaCorrienteHabilitada Boolean          @default(false) @map("cuenta_corriente_habilitada")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")
  vehiculos                 Vehiculo[]
  facturas                  Factura[]

  @@map("clientes")
}

model Vehiculo {
  id        Int          @id @default(autoincrement())
  clienteId Int          @map("cliente_id")
  tipo      VehiculoTipo
  subtipo   String
  marca     String?
  modelo    String?
  patente   String?
  activo    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  turnos  Turno[]

  @@map("vehiculos")
}

model Servicio {
  id          Int          @id @default(autoincrement())
  nombre      String
  descripcion String?
  vehiculo    VehiculoTipo
  subtipo     String
  precio      Int // neto, sin IVA — pesos enteros (sin centavos), igual que en la demo
  activo      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  turnos      Turno[]

  @@map("servicios")
}

enum Linea {
  A
  B
}

enum EstadoTurno {
  RESERVADO
  COMPLETADO
  CANCELADO
}

enum FormaPago {
  CONTADO
  TRANSFERENCIA
  EFECTIVO
  CUENTA_CORRIENTE
}

model Turno {
  id          Int         @id @default(autoincrement())
  fecha       DateTime    @db.Date // día del turno — reemplaza las claves TURNOS_POR_DIA de la demo
  hora        String // 'HH:MM' — la grilla de horarios configurable llega en la Etapa 3d
  linea       Linea       @default(A)
  vehiculoId  Int         @map("vehiculo_id")
  servicioId  Int         @map("servicio_id")
  // Precio neto YA con el descuento de empresa aplicado (si corresponde),
  // calculado y guardado al crear/editar el turno — no se recalcula después,
  // para que un cambio de precio de lista o de % de descuento no altere
  // turnos ya cargados (fundamental para la Etapa de Facturación).
  precioNeto  Int         @map("precio_neto")
  estado      EstadoTurno @default(RESERVADO)
  formaPago   FormaPago   @map("forma_pago")
  pagado      Boolean     @default(false)
  facturar    Boolean     @default(true) // false = se cobra pero no se emite comprobante (ver Etapa 3f)
  facturaId   Int?        @map("factura_id") // null hasta el cierre diario que lo factura
  // Etapa 3h (Reseñas): se genera al completar el turno — identifica el link
  // público de encuesta que se manda por WhatsApp ("/encuesta/:token"). Null
  // en turnos que todavía no se completaron.
  resenaToken String?     @unique @map("resena_token")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])
  servicio Servicio @relation(fields: [servicioId], references: [id])
  factura  Factura? @relation(fields: [facturaId], references: [id])
  resena   Resena?

  @@index([fecha])
  @@map("turnos")
}

// ──────────────────────────────────────────────
// Etapa 3f: Facturación. Se genera al cerrar el control diario de una fecha:
// agrupa los turnos COMPLETADOs de ese día con facturar=true por cliente (un
// cliente con más de un vehículo ese día → UN solo comprobante consolidado,
// no uno por vehículo) y calcula neto/IVA/total a partir del precioNeto ya
// guardado en cada turno (con el descuento de empresa ya aplicado).
//
// Los campos CAE/caeFchVto/numeroArca quedan null hasta que haya
// certificado real de ARCA cargado — ver apps/backend/src/lib/arca/.
// Mientras tanto TODO comprobante funciona como interno (sin timbrado
// fiscal), aunque `comprobante` diga ARCA para las empresas que así lo
// tengan configurado (es la condición fiscal del cliente, no si ya se
// emitió de verdad contra ARCA).
// ──────────────────────────────────────────────

enum EstadoFactura {
  PENDIENTE // cuenta corriente, todavía no cobrada
  PAGADA
}

model Factura {
  id          Int             @id @default(autoincrement())
  numero      String          @unique // correlativo interno, ej. "F-20261018-1"
  fecha       DateTime        @db.Date
  clienteId   Int             @map("cliente_id")
  comprobante TipoFacturacion
  neto        Int
  iva         Int
  total       Int
  formaPago   FormaPago       @map("forma_pago")
  estado      EstadoFactura   @default(PAGADA)
  // Se completan recién si se emite de verdad contra ARCA (ver wsfev1.ts) —
  // mientras tanto quedan null y el comprobante es puramente interno.
  cae         String?
  caeFchVto   DateTime?       @map("cae_fch_vto")
  puntoVenta  Int?            @map("punto_venta")
  numeroArca  Int?            @map("numero_arca")
  createdAt   DateTime        @default(now()) @map("created_at")

  cliente Cliente @relation(fields: [clienteId], references: [id])
  turnos  Turno[]

  @@index([fecha])
  @@map("facturas")
}

// ──────────────────────────────────────────────
// Etapa 3d: Horarios y Cupos. Siempre hay exactamente 7 filas (una por día
// de la semana, 0=domingo..6=sábado, igual que Date.getDay()) — no es un
// recurso que se cree/borre, solo se lee y edita. Los cupos por franja
// horaria (qué modo tiene cada 08:00, 09:15, etc.) van en un JSON porque
// siempre se leen y graban como bloque completo del día, nunca slot por
// slot — el turnero público (Etapa 4) va a leer este bloque entero para
// calcular la disponibilidad real.
// ──────────────────────────────────────────────

enum ModoSlot {
  CAMION
  AUTO
  LIBRE
  CERRADO
}

model HorarioDia {
  id               Int      @id @default(autoincrement())
  diaSemana        Int      @unique @map("dia_semana") // 0=domingo..6=sábado
  abierto          Boolean  @default(true)
  desde            String // 'HH:MM'
  hasta            String // 'HH:MM'
  modos            Json // { "08:00": "CAMION", "09:15": "LIBRE", ... }
  lineaBHabilitada Boolean  @default(false) @map("linea_b_habilitada")
  lineaBDesde      String?  @map("linea_b_desde")
  lineaBHasta      String?  @map("linea_b_hasta")
  modosLineaB      Json?    @map("modos_linea_b")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("horarios_dia")
}

// ──────────────────────────────────────────────
// Etapa 3g: Gastos. Sin relación con otras tablas (nadie referencia un
// Gasto), así que a diferencia de Cliente/Servicio acá "baja" es borrar de
// verdad — no hace falta un flag `activo`.
// ──────────────────────────────────────────────

enum CategoriaGasto {
  SUELDOS
  IMPUESTOS
  SERVICIOS
  INSUMOS
  OTRO
}

model Gasto {
  id          Int            @id @default(autoincrement())
  fecha       DateTime       @db.Date
  categoria   CategoriaGasto
  monto       Int
  descripcion String?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([fecha])
  @@map("gastos")
}

// ──────────────────────────────────────────────
// Etapa 3h: Reseñas. Al completar un turno se genera un link público de
// encuesta (Turno.resenaToken) y se manda por WhatsApp al cliente — el envío
// real todavía está gateado (ver apps/backend/src/lib/whatsapp/), igual que
// ARCA, hasta tener una sesión de whatsapp-web.js activa.
//
// El cliente entra al link SIN login, puntúa 1-5 y deja un comentario
// opcional: eso crea la Resena (estado PENDIENTE). El admin la aprueba u
// oculta antes de que se vea en el turnero público — solo las APROBADA se
// muestran ahí.
// ──────────────────────────────────────────────

enum EstadoResena {
  PENDIENTE
  APROBADA
  OCULTA
}

model Resena {
  id         Int          @id @default(autoincrement())
  turnoId    Int          @unique @map("turno_id")
  puntaje    Int // 1 a 5
  comentario String?
  estado     EstadoResena @default(PENDIENTE)
  createdAt  DateTime     @default(now()) @map("created_at")

  turno Turno @relation(fields: [turnoId], references: [id])

  @@map("resenas")
}
