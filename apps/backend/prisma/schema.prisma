generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Etapa 1 (scaffolding): Prisma no genera el cliente sin al menos un modelo,
// así que User/RefreshToken arrancan acá — es el modelo de datos mínimo e
// inevitable para validar que Prisma + Postgres funcionan de punta a punta.
// La lógica de login (endpoints, JWT, etc.) se construye recién en la Etapa 2.
// El resto de los modelos (Cliente, Turno, Servicio, Empresa, Factura...)
// se agregan a medida que avanzamos por las etapas siguientes.

enum Role {
  ADMIN
  OPERATOR
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String
  role          Role           @default(ADMIN)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ──────────────────────────────────────────────
// Etapa 3a (Agenda): Cliente y Servicio se modelan acá como tablas reales
// (Turno necesita referenciarlos por FK, no por texto libre como en la demo).
// Acá solo se exponen las operaciones mínimas que la Agenda necesita (listar
// y, en el caso de Cliente, alta rápida desde el modal de turno); el ABM
// completo con sus pantallas dedicadas llega en las Etapas 3b y 3c.
//
// Empresa (cuenta corriente, facturación consolidada, tarifas diferenciales)
// todavía NO se modela: en la demo un camión de empresa es simplemente un
// Cliente más, correlacionado por nombre — eso se revisa recién en la
// Etapa 3e, cuando sepamos exactamente qué necesita Empresas/Facturación.
// ──────────────────────────────────────────────

enum VehiculoTipo {
  CAMION
  AUTO
}

model Cliente {
  id           Int          @id @default(autoincrement())
  denominacion String
  telefono     String
  cuit         String?
  email        String?
  direccion    String?
  vehiculo     VehiculoTipo
  subtipo      String
  marca        String?
  modelo       String?
  patente      String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  turnos       Turno[]

  @@map("clientes")
}

model Servicio {
  id          Int          @id @default(autoincrement())
  nombre      String
  descripcion String?
  vehiculo    VehiculoTipo
  subtipo     String
  precio      Int // neto, sin IVA — pesos enteros (sin centavos), igual que en la demo
  activo      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  turnos      Turno[]

  @@map("servicios")
}

enum Linea {
  A
  B
}

enum EstadoTurno {
  RESERVADO
  COMPLETADO
  CANCELADO
}

enum FormaPago {
  CONTADO
  TRANSFERENCIA
  EFECTIVO
  CUENTA_CORRIENTE
}

model Turno {
  id         Int         @id @default(autoincrement())
  fecha      DateTime    @db.Date // día del turno — reemplaza las claves TURNOS_POR_DIA de la demo
  hora       String // 'HH:MM' — la grilla de horarios configurable llega en la Etapa 3d
  linea      Linea       @default(A)
  clienteId  Int         @map("cliente_id")
  servicioId Int         @map("servicio_id")
  patente    String // se guarda aparte del Cliente: un turno puntual puede ser para otro vehículo
  estado     EstadoTurno @default(RESERVADO)
  formaPago  FormaPago   @map("forma_pago")
  pagado     Boolean     @default(false)
  facturar   Boolean     @default(true) // false = se cobra pero no se emite comprobante (ver Etapa 3f)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  cliente  Cliente  @relation(fields: [clienteId], references: [id])
  servicio Servicio @relation(fields: [servicioId], references: [id])

  @@index([fecha])
  @@map("turnos")
}
